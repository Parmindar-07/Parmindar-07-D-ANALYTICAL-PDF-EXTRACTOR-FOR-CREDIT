# ================================================================================
#  env.example — Environment Variable Template
# ================================================================================
#
#  SETUP INSTRUCTIONS:
#    1. Copy this file to .env:
#         cp env.example .env
#    2. Fill in your API keys and Sheet IDs
#    3. Enable at least one AI provider
#    4. Run: python web_app.py
#
#  SECURITY:
#    Never commit .env to GitHub — it contains private API keys.
#    This file (env.example) is safe to commit — it has no real secrets.
# ================================================================================


# ── Server Configuration ────────────────────────────────────────────────────────
OCR_WEB_PORT=8765          # Port for the web server (default: 8765)
OCR_WEB_OPEN=0             # Set to 1 to auto-open browser on startup


# ── AI Configuration ────────────────────────────────────────────────────────────
AI_PROVIDER_ORDER=gemini,claude,openai   # Priority order — first enabled provider is used
AI_PROMPT_PATH=prompts/extraction_prompt.txt
AI_TEXT_LIMIT=8000                       # Max characters sent to AI per request


# ── OCR / Text Cleaning ─────────────────────────────────────────────────────────
RAW_TEXT_BLOCKLIST_PATH=raw_text_remove_lines.txt
RAW_TEXT_MAX_LINE_LENGTH=70              # Lines longer than this are removed from AI input


# ── Google Gemini ───────────────────────────────────────────────────────────────
GEMINI_ENABLED=false
GEMINI_API_KEY=                          # Get from: aistudio.google.com
GEMINI_MODEL=gemini-2.0-flash


# ── Anthropic Claude ────────────────────────────────────────────────────────────
# Claude is required for direct PDF extraction (no OCR needed).
# Recommended for handwritten or scanned PDFs.
CLAUDE_ENABLED=false
CLAUDE_API_KEY=                          # Get from: console.anthropic.com
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=8000


# ── OpenAI GPT ──────────────────────────────────────────────────────────────────
OPENAI_ENABLED=false
OPENAI_API_KEY=                          # Get from: platform.openai.com
OPENAI_MODEL=gpt-4.1-mini


# ── Google Sheets Integration ───────────────────────────────────────────────────
# Set CREDIT_GOOGLE_SHEET_ENABLED=false to disable Google Sheets sync entirely.
# The app still works — it just won't save to Google Sheets.
CREDIT_GOOGLE_SHEET_ENABLED=true

# Path to your Google Service Account credentials JSON file.
# Download from: Google Cloud Console → IAM → Service Accounts → Keys → JSON
# The service account must have Editor access to your spreadsheet(s).
CREDIT_GOOGLE_CREDENTIALS_PATH=..\SF\credentials.json

# ── Multiple Google Sheets (up to 9) ────────────────────────────────────────────
# Configure multiple sheets to distribute submissions across them (round-robin).
# Use either the full URL or just the spreadsheet ID.
# Set GOOGLE_SHEET_N_ENABLED=false to skip a specific sheet.

GOOGLE_SHEET_1_ENABLED=true
GOOGLE_SHEET_ID_1=                       # e.g. 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

GOOGLE_SHEET_2_ENABLED=true
GOOGLE_SHEET_ID_2=

GOOGLE_SHEET_3_ENABLED=true
GOOGLE_SHEET_ID_3=
